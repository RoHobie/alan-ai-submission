# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to Flash-tier Gemini model; summary model is optional)
LLM_MODEL=gemini-2.5-flash
LLM_SUMMARY_MODEL=

# Storage and Runtime
DATA_DIR=/app/data
MAX_LLM_CONCURRENCY=3
LOG_LEVEL=INFO
PORT=8000
